library ieee;
use ieee.std_logic_1164.all;

--En entity describimos el circuito o las partes que vamos a usar para hacer el circuito
entity Practica1 is
    port (LEDR : out std_logic_vector(9 downto 0));
end entity Practica1;

-- En architecture ponemos el funcionamiento del circuito 
architecture funcionamiento of Practica1 is
begin
    LEDR <= "0000010000";
end architecture funcionamiento;
